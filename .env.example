# Direct OpenAI API access for Codex (server only).
OPENAI_API_KEY=

# A Codex-compatible model and Vercel Sandbox credentials.
CODEX_MODEL=gpt-5.3-codex
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Alternative to the three Vercel fields above: VERCEL_OIDC_TOKEN

PORT=4310

# Initial and active runtime allowance. Minimum 1 minute.
SANDBOX_ACTIVE_MINUTES=10

# Idle runtime allowance after a completed turn; fractional minutes allowed.
SANDBOX_IDLE_MINUTES=10
