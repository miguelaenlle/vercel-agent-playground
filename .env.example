# Direct OpenAI API access for Codex (server only).
OPENAI_API_KEY=

# A Codex-compatible model and Vercel Sandbox credentials.
CODEX_MODEL=gpt-5.3-codex
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Alternative to the three Vercel fields above: VERCEL_OIDC_TOKEN

PORT=4310

# Deployed Workflow service (this repo's Vercel deployment).
LIFECYCLE_URL=
# Same random secret on the local server and Vercel deployment.
LIFECYCLE_SECRET=
# Applies to new sandboxes. Fractional minutes are useful for testing.
SANDBOX_IDLE_MINUTES=10
